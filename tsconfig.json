// TypeScript: the ACMElabs preset. Each option's reason: packages/config/tsconfig.json.
// This repo extends the preset's own file by relative path, as its oxlint and oxfmt configs import
// the preset's source: the root does not depend on @acmelabs/config. The preset sets no include,
// so this repo names its own.
{
  "extends": "./packages/config/tsconfig.json",
  "include": ["packages/**/*.ts"],
  // A local build writes type files into packages/*/dist. They are build output, not source, so a
  // stale build cannot change the typecheck.
  "exclude": ["packages/*/dist"]
}
