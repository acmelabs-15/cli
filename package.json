{
  "name": "@acmelabs/cli-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages oxlint.config.ts oxfmt.config.ts",
    "format": "oxfmt packages oxlint.config.ts oxfmt.config.ts",
    "format:check": "oxfmt --check packages oxlint.config.ts oxfmt.config.ts",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.3.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.6.0",
    "ultracite": "7.12.0"
  }
}
