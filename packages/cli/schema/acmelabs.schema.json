{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "plugin": {
      "type": "object",
      "properties": {
        "hosts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["claude-code", "codex", "gemini-cli", "antigravity-cli"]
          },
          "uniqueItems": true
        }
      },
      "required": ["hosts"],
      "additionalProperties": false
    },
    "library": {
      "type": "object",
      "properties": {
        "packages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!\\s*$)(?!/)(?![A-Za-z]:)(?![^\\\\]*\\\\)(?![^\\x00]*\\x00)(?!(?:[^/]*/)*\\.\\.(?:/|$))",
            "description": "A package folder's path from the repo root, with \"/\" between folders: not blank, not absolute, no drive prefix such as \"C:\", no backslash or NUL character, and no \"..\" segment."
          },
          "uniqueItems": true,
          "description": "The package folders that publish, as relative paths from the repo root, each one once. Editors compare the paths as written, so \"./packages/cli\" and \"packages/cli\" are no repeat to an editor; acmelabs counts them as one."
        }
      },
      "required": ["packages"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": ["plugin"]
    },
    {
      "required": ["library"]
    }
  ]
}
